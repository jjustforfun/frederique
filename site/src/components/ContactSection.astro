---
/**
 * Contact / booking — coordonnées exactes de l’artiste (relevées sur son site).
 * Pas de formulaire : mailto + tel = zéro backend, zéro cookie, zéro donnée stockée.
 */
import { SITE, LINKS } from '../data/site';
---

<section id="contact" class="contact sea" aria-labelledby="contact-title">
  <div class="stars" aria-hidden="true"><i></i></div>
  <div class="wrap contact__inner">
    <header class="section-head">
      <p class="kicker">Embarquer</p>
      <h2 id="contact-title">Un port, une fête, une scène — écrivez-lui</h2>
    </header>

    <p class="contact__lede">
      Festivals du littoral, fêtes de la mer, églises maritimes, scènes de port :
      Frédérique répond elle-même. Devis, rider et dossier de presse sur demande.
    </p>

    <ul class="contact__ways">
      <li>
        <a class="contact__way card" href={`mailto:${SITE.email}`}>
          <span class="contact__way-label">Courriel</span>
          <span class="contact__way-value">{SITE.email}</span>
        </a>
      </li>
      <li>
        <a class="contact__way card" href={`tel:${SITE.phone}`}>
          <span class="contact__way-label">Téléphone</span>
          <span class="contact__way-value">{SITE.phonePretty}</span>
        </a>
      </li>
      <li>
        <a class="contact__way card" href={LINKS.youtube} rel="noopener" target="_blank">
          <span class="contact__way-label">Vidéos & clips</span>
          <span class="contact__way-value">Chaîne Fredlarouge</span>
        </a>
      </li>
    </ul>
  </div>

  <div class="waves waves--back" aria-hidden="true">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
      <path d="M0 30 Q 75 8 150 30 T 300 30 T 450 30 T 600 30 T 750 30 T 900 30 T 1050 30 T 1200 30 V 60 H 0 Z" fill="var(--foam)"/>
    </svg>
  </div>
  <div class="waves" aria-hidden="true">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
      <path d="M0 34 Q 100 12 200 34 T 400 34 T 600 34 T 800 34 T 1000 34 T 1200 34 V 60 H 0 Z" fill="var(--bg)"/>
    </svg>
  </div>

  <style>
    .contact {
      position: relative;
      padding-block: clamp(4.5rem, 9vw, 7.5rem);
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--sea) 45%, var(--sea-deep)) 0%,
        var(--sea-deep) 62%
      );
      color: #eef4f6;
    }

    .contact h2, .contact p, .contact .section-head::after { color: #eef4f6; }
    .contact .section-head::after { background: linear-gradient(90deg, rgba(238,244,246,0.75), transparent); }
    .contact .kicker { color: var(--gold-band); }

    .contact__inner { position: relative; z-index: 1; }

    .contact__lede { max-width: 58ch; margin-bottom: 2rem; }

    .contact__ways {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.9rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    }

    .contact__way {
      display: grid;
      gap: 0.3rem;
      padding: 1.1rem 1.25rem;
      text-decoration: none;
      color: var(--text);
      border-radius: var(--radius);
      transition: translate 0.16s ease;
    }

    .contact__way:hover { translate: 0 -3px; color: var(--text); }

    .contact__way-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .contact__way-value { font-weight: 600; overflow-wrap: anywhere; }
  </style>
</section>
