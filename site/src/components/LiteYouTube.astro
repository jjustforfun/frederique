---
/**
 * Façade YouTube « lite » : aucune requête vers Google avant le clic
 * (RGPD + 0 octet vidéo au chargement). Au clic, l’iframe nocookie remplace
 * l’image de couverture — lazy-load natif pour l’image.
 */
interface Props {
  id: string;
  title: string;
  caption?: string;
}
const { id, title, caption } = Astro.props;
---

<div class="lite-yt card" data-yt={id}>
  <button type="button" class="lite-yt__btn" data-yt-play aria-label={`Lire la vidéo : ${title}`}>
    <img
      class="lite-yt__poster"
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
      alt=""
    />
    <span class="lite-yt__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
    </span>
  </button>
  <p class="lite-yt__title">
    <a href={`https://www.youtube.com/watch?v=${id}`} rel="noopener noreferrer" target="_blank">{title}</a>
  </p>
  {caption && <p class="lite-yt__caption">{caption}</p>}
</div>

<style>
  .lite-yt { overflow: hidden; padding: 0; }

  .lite-yt__btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    aspect-ratio: 16 / 9;
    background: var(--sea-deep);
  }

  .lite-yt__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: filter 0.2s ease, scale 0.4s ease;
  }

  .lite-yt__btn:hover .lite-yt__poster { scale: 1.03; }

  .lite-yt__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4.2rem;
    height: 4.2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 88%, black 4%);
    color: var(--accent-contrast);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: scale 0.15s ease;
  }

  .lite-yt__btn:hover .lite-yt__play { scale: 1.07; }

  .lite-yt__title { margin: 0.85rem 1rem 0; font-weight: 600; font-size: 0.95rem; }
  .lite-yt__title a { color: var(--text); text-decoration: none; }
  .lite-yt__title a:hover { color: var(--accent-strong); }
  .lite-yt__caption { margin: 0.15rem 1rem 1rem; font-size: 0.83rem; color: var(--muted); }

  iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    display: block;
  }
</style>

<script>
  // Au clic : chargement de la vraie iframe (seule source de données Google).
  for (const box of document.querySelectorAll<HTMLElement>('[data-yt]')) {
    box.querySelector('[data-yt-play]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = box.querySelector('.lite-yt__title')?.textContent?.trim() ?? 'Vidéo YouTube';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
      iframe.focus?.(); // rien à faire côté focus, le lecteur prend le relais
    });
  }
</script>
